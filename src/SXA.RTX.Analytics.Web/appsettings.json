{
  "ConnectionStrings": {
    // Placeholder — override via User Secrets, env var or appsettings.Development.json (not committed).
    // Example: "Server=localhost;Database=SXA_RTX_Analytics;Trusted_Connection=True;TrustServerCertificate=True;"
    //
    // OperationalDatabase: base donde viven las tablas VTI/VTech que consulta /query.
    //   Si se deja vacia, /query usa ConfigurationDatabase.
    // MapicsOdbc: cadena ODBC de MAPICS (DSN=...).
    //
    // En IIS se recomienda definirlas como variables de entorno del App Pool:
    //   ConnectionStrings__ConfigurationDatabase
    //   ConnectionStrings__OperationalDatabase
    "ConfigurationDatabase": "",
    "OperationalDatabase": "",
    "MapicsOdbc": ""
  },
  "UpdateCheck": {
    // Minutos entre consultas a GitHub Releases. 0 desactiva la comprobacion.
    "IntervalMinutes": 60
  },
  "BootstrapAdmin": {
    // Recuperacion de acceso: si TODOS olvidan su contraseña, define en el entorno
    // (variable de entorno del App Pool / servicio):
    //   BootstrapAdmin__Username = ECCSA
    //   BootstrapAdmin__Password = <nueva contraseña temporal>
    //   BootstrapAdmin__ResetPassword = true
    // y reinicia. Ese usuario queda como Administrador y obligado a cambiar la
    // contraseña en el proximo inicio de sesion. Luego retira ResetPassword.
    "Username": "ECCSA",
    "DisplayName": "ECCSA",
    "Password": "",
    "ResetPassword": false
  },
  "SelfUpdate": {
    // Actualizacion automatica. Solo se habilita en el servidor si el proceso puede
    // reemplazar sus propios archivos (Windows Service con identidad con permisos).
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
