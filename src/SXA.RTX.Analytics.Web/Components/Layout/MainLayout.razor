@inherits LayoutComponentBase
@implements IDisposable
@using SXA.RTX.Analytics.Application.Abstractions
@inject AuthenticationStateProvider AuthState
@inject IConfigurationService Settings
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <div class="rx-watermark" aria-hidden="true"></div>
    <div class="sidebar @(_sidebarCollapsed ? "is-collapsed" : "")">
        <NavMenu Collapsed="_sidebarCollapsed" />
    </div>

    <main>
        <div class="top-row px-4 rtx-topbar">
            <button class="btn btn-sm btn-outline-secondary rx-btn-icon d-none d-md-inline-flex" @onclick="ToggleSidebar"
                    title="Colapsar menú" aria-label="Colapsar menú">
                <Icon Name="panel" Size="16" />
            </button>
            <div class="ms-auto d-flex align-items-center gap-3">
                <span class="rx-chip rx-chip--ok"><span class="rx-dot"></span> En línea</span>
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-2 small">
                                <span style="width:30px;height:30px;border-radius:50%;background:var(--rx-accent-soft);color:var(--rx-accent-strong);display:grid;place-items:center;font-weight:700;font-size:.8rem">@Initial(context.User.Identity?.Name)</span>
                                <span class="fw-semibold d-none d-sm-inline">@context.User.Identity?.Name</span>
                                <span class="rx-chip d-none d-lg-inline-flex">@Role(context)</span>
                            </span>
                            <button class="btn btn-sm btn-outline-secondary rx-btn-icon" @onclick="ToggleTheme" title="Cambiar tema claro/oscuro" aria-label="Cambiar tema"><Icon Name="theme" Size="16" /></button>
                            <a href="/logout" class="btn btn-sm btn-outline-secondary"><Icon Name="logout" Size="16" /> <span class="d-none d-sm-inline">Salir</span></a>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-sm btn-primary">Entrar</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="px-4 py-3 rtx-footer mt-4">
            <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <img src="img/eccsa.png" alt="ECCSA Automation" height="22" class="rtx-footer-logo" />
                    <span class="vr d-none d-sm-block" style="height:20px"></span>
                    <img src="img/hussmann.png" alt="Hussmann" height="16" class="rtx-footer-logo" />
                    <span class="d-none d-lg-inline">Uso interno · confidencial</span>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <span>v@(Version)</span>
                    <a href="/health" target="_blank" class="text-muted text-decoration-none">Estado del sistema</a>
                </div>
            </div>
        </footer>
    </main>
</div>

@if (ShowUpdateAdmin)
{
    <div class="modal d-block" style="background:rgba(0,0,0,.45); position:fixed; inset:0; z-index:1050; display:grid; place-items:center">
        <div class="card" style="max-width:560px; width:90%">
            <div class="card-body">
                <h5 class="fw-bold">Actualización disponible — v@(LatestVersion)</h5>
                <p class="small text-muted">Versión actual v@(Version). Hay una nueva versión con cambios:</p>
                <pre class="small bg-light border rounded p-2" style="max-height:220px; overflow:auto; white-space:pre-wrap">@PrettyChangelog(Changelog)</pre>
                <div class="d-flex flex-wrap align-items-center gap-2 justify-content-end">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ShowUpdateAdmin=false">Recordar más tarde</button>
                    <a href="@UpdateUrl" target="_blank" class="btn btn-outline-primary btn-sm">Ver release</a>
                    <a href="@UpdateUrl" target="_blank" class="btn btn-primary btn-sm" @onclick="() => ShowUpdateAdmin=false">Actualizar</a>
                </div>
            </div>
        </div>
    </div>
}
@if (ShowChangelogAll)
{
    <div class="modal d-block" style="background:rgba(0,0,0,.45); position:fixed; inset:0; z-index:1050; display:grid; place-items:center">
        <div class="card" style="max-width:560px; width:90%">
            <div class="card-body">
                <h5 class="fw-bold">Novedades v@(LatestVersion)</h5>
                <pre class="small bg-light border rounded p-2" style="max-height:220px; overflow:auto; white-space:pre-wrap">@PrettyChangelog(Changelog)</pre>
                <div class="d-flex justify-content-end"><button class="btn btn-primary btn-sm" @onclick="DismissChangelog">Entendido</button></div>
            </div>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    string Initial(string? name) => string.IsNullOrEmpty(name) ? "?" : name.Substring(0,1).ToUpperInvariant();
    bool IsAdmin(AuthenticationState s) => s.User.IsInRole("Administrador");
    string Role(AuthenticationState s) => s.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

    async Task ToggleTheme()
    {
        try { await JS.InvokeVoidAsync("rxToggleTheme"); } catch { }
    }

    bool _sidebarCollapsed;

    async Task ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        try { await JS.InvokeVoidAsync("eval", $"localStorage.setItem('rx-sidebar-collapsed','{(_sidebarCollapsed ? "1" : "0")}')"); } catch { }
    }

    async Task LoadSidebarState()
    {
        try { _sidebarCollapsed = await JS.InvokeAsync<bool>("eval", "localStorage.getItem('rx-sidebar-collapsed')==='1'"); } catch { }
    }

    // Convierte el markdown del release (titulos, tablas, negritas, codigo) a texto plano legible.
    string PrettyChangelog(string? md)
    {
        if (string.IsNullOrWhiteSpace(md)) return string.Empty;
        var outp = new System.Text.StringBuilder();
        foreach (var raw in md.Replace("\r\n", "\n").Split('\n'))
        {
            var line = raw.TrimEnd();
            if (string.IsNullOrWhiteSpace(line)) { outp.Append('\n'); continue; }
            if (line.TrimStart().StartsWith("---") || line.Trim() == "|") continue;   // separadores
            if (line.TrimStart().StartsWith("|"))                                        // tabla -> lista
            {
                var cells = line.Trim().Trim('|').Split('|')
                              .Select(c => Clean(c)).Where(c => c.Length > 0).ToArray();
                if (cells.Length == 0) continue;
                if (cells.All(c => c.All(ch => ch is '-' or ':' or ' '))) continue;       // fila separadora
                outp.Append("  • ").AppendLine(string.Join("  —  ", cells));
                continue;
            }
            outp.AppendLine(Clean(line));
        }
        return outp.ToString().Trim();

        static string Clean(string s)
        {
            s = s.Trim();
            while (s.StartsWith("#")) s = s.TrimStart('#').Trim();
            s = s.Replace("**", "").Replace("`", "").Replace("  ", " ");
            return s.Trim();
        }
    }

    string Version = "1.0.0";
    string? LatestVersion, Changelog, UpdateUrl;
    bool ShowUpdateAdmin, ShowChangelogAll;
    int UpdateCheckMinutes = 60;
    System.Threading.Timer? _timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Primera vez: versión + comprobación. Luego se repite cada N minutos contra
        // /api/updates/check, que ya responde desde la caché del servidor (el servidor es
        // el único que llama a GitHub, así que el coste no depende del número de usuarios).
        _ = InitializeAsync();
    }

    bool _initialized;
    async Task InitializeAsync()
    {
        if (_initialized) return;
        _initialized = true;
        await LoadSidebarState();
        await EnforcePasswordChange();
        await LoadUpdateInterval();
        await RefreshVersionAndUpdates(initial: true);
        ScheduleNextCheck();
    }

    // Si la cuenta fue recuperada (superadmin reseteado) obliga a cambiar la contraseña.
    async Task EnforcePasswordChange()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var mustChange = auth.User.HasClaim(c => c.Type == "MustChangePassword" && c.Value == "true");
            if (mustChange && !Nav.Uri.Contains("/account/password", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/account/password", forceLoad: true);
        }
        catch { }
    }

    async Task RefreshVersionAndUpdates(bool initial)
    {
        try
        {
            var http = HttpFactory.CreateClient();
            http.BaseAddress = new Uri(Nav.BaseUri);
            try { var v = await http.GetFromJsonAsync<VersionInfo>("/api/version"); if (v != null && !string.IsNullOrEmpty(v.version)) Version = v.version; } catch { }
            var auth = await AuthState.GetAuthenticationStateAsync();
            var isAdmin = auth.User.IsInRole("Administrador");
            var upd = await http.GetFromJsonAsync<UpdateInfo>("/api/updates/check");
            if (upd != null && !string.IsNullOrEmpty(upd.latest) && upd.hasUpdate)
            {
                var latest = upd.latest?.TrimStart('v', 'V');
                Changelog = upd.changelog; UpdateUrl = upd.url;
                // El modal solo se (re)abre si la versión es distinta a la ya mostrada.
                if (latest != LatestVersion)
                {
                    LatestVersion = latest;
                    if (isAdmin) ShowUpdateAdmin = true;
                    else
                    {
                        var lastSeen = await JS.InvokeAsync<string>("eval", "localStorage.getItem('sxa_lastSeenVersion') || ''");
                        if (lastSeen != LatestVersion) ShowChangelogAll = true;
                    }
                }
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    void ScheduleNextCheck()
    {
        var minutes = UpdateCheckMinutes;
        if (minutes <= 0) return;
        _timer?.Dispose();
        _timer = new System.Threading.Timer(async _ =>
        {
            try
            {
                // InvokeAsync lanza si el circuito ya se cerró; se captura para no matar el timer.
                await InvokeAsync(async () => { await RefreshVersionAndUpdates(initial: false); });
            }
            catch (ObjectDisposedException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }, null, TimeSpan.FromMinutes(minutes), Timeout.InfiniteTimeSpan);
    }

    async Task LoadUpdateInterval()
    {
        try
        {
            var raw = await Settings.GetValueAsync(SettingsKeys.UpdateCheckMinutes);
            if (int.TryParse(raw, out var m) && m >= 0) UpdateCheckMinutes = m;
        }
        catch { }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
    async Task DismissChangelog()
    {
        ShowChangelogAll = false;
        if (!string.IsNullOrEmpty(LatestVersion))
            await JS.InvokeVoidAsync("eval", $"localStorage.setItem('sxa_lastSeenVersion','{LatestVersion}')");
    }
    record VersionInfo(string version);
    record UpdateInfo(string current, string latest, bool hasUpdate, string changelog, string url);
}
