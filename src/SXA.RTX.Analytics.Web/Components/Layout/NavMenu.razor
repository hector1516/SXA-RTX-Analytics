@* Menú lateral. Colapsable (solo iconos) según el parámetro Collapsed. *@
<div class="rtx-sidebar @(Collapsed ? "is-collapsed" : "")">
    <div class="rtx-brand px-3 py-3">
        <a href="" class="text-decoration-none d-flex align-items-center gap-2">
            <img src="img/logo.png" alt="SXA-RTX" width="36" height="36" class="rtx-logo" />
            <div class="lh-sm rtx-brand-text">
                <div class="rtx-brand-title">SXA-RTX</div>
                <div class="rtx-brand-tag">Analytics</div>
            </div>
        </a>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column gap-1 px-2 py-2">
            <div class="nav-item">
                <NavLink class="nav-link rtx-navlink" href="" Match="NavLinkMatch.All" title="Inicio">
                    <span class="rtx-nav-icon"><Icon Name="home" Size="18" /></span>
                    <span class="rtx-nav-label">Inicio</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link rtx-navlink" href="query" title="Consulta">
                    <span class="rtx-nav-icon"><Icon Name="chart" Size="18" /></span>
                    <span class="rtx-nav-label">Consulta</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link rtx-navlink" href="trace" title="Trazabilidad">
                    <span class="rtx-nav-icon"><Icon Name="timeline" Size="18" /></span>
                    <span class="rtx-nav-label">Trazabilidad</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link rtx-navlink" href="reports" title="Reportes">
                    <span class="rtx-nav-icon"><Icon Name="database" Size="18" /></span>
                    <span class="rtx-nav-label">Reportes</span>
                </NavLink>
            </div>
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link rtx-navlink" href="configuration" title="Configuración">
                            <span class="rtx-nav-icon"><Icon Name="settings" Size="18" /></span>
                            <span class="rtx-nav-label">Configuración</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link rtx-navlink" href="users" title="Usuarios">
                            <span class="rtx-nav-icon"><Icon Name="users" Size="18" /></span>
                            <span class="rtx-nav-label">Usuarios</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>
    </div>
</div>

@code {
    [Parameter] public bool Collapsed { get; set; }
}

<style>
    .rtx-sidebar { display: flex; flex-direction: column; height: 100%; }

    .navbar-toggler {
        appearance: none;
        cursor: pointer;
        width: 3rem;
        height: 2.25rem;
        color: var(--rx-sidebar-text);
        position: absolute;
        top: 0.75rem;
        right: 1rem;
        border: 1px solid var(--rx-sidebar-border);
        border-radius: 8px;
        background: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%2815,23,42,0.6%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") no-repeat center/1.25rem;
    }
    .navbar-toggler:checked { background-color: var(--rx-sidebar-hover); }

    .nav-item { font-size: 0.9rem; }
    .nav-scrollable { display: none; }
    .navbar-toggler:checked ~ .nav-scrollable { display: block; }

    /* Colapsado: solo iconos, centrados */
    .rtx-sidebar.is-collapsed .rtx-brand-text { display: none; }
    .rtx-sidebar.is-collapsed .rtx-brand { justify-content: center; padding-left: 0 !important; padding-right: 0 !important; }
    .rtx-sidebar.is-collapsed .rtx-nav-label { display: none; }
    .rtx-sidebar.is-collapsed .rtx-navlink { justify-content: center; gap: 0; padding-left: 0; padding-right: 0; }
    .rtx-sidebar.is-collapsed .nav { padding-left: .5rem; padding-right: .5rem; }

    @@media (min-width: 641px) {
        .navbar-toggler { display: none; }
        .nav-scrollable { display: block; flex: 1; overflow-y: auto; }
    }
</style>
