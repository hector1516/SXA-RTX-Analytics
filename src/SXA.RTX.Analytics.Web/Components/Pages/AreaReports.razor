@page "/reports/areas"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SXA.RTX.Analytics.Application.Abstractions
@inject ITablasConfigService TablasService
@inject IDataSourceService DataSources
@inject IExportService ExportService
@inject IJSRuntime JS

<PageTitle>Reportes por área - SXA-RTX Analytics</PageTitle>

<div class="rx-page-head">
    <div>
        <div class="rx-eyebrow">Reportes</div>
        <h1>Reportes por área</h1>
        <div class="text-muted small">Resumen y exportación de las tablas configuradas, agrupadas por fuente.</div>
    </div>
    <a href="/query" class="btn btn-sm btn-outline-primary">Consulta libre</a>
</div>

@if (IsLoading)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else if (Groups.Count == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <div class="mt-2">No hay tablas configuradas. Ve a <a href="/configuration">Configuración</a> para agregarlas.</div>
    </div></div>
}
else
{
    @foreach (var g in Groups)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@g.Key</strong>
                <span class="badge bg-secondary">@g.Value.Count tabla(s)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tabla</th>
                                <th>Título</th>
                                <th>Serie</th>
                                <th>Fecha</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in g.Value)
                            {
                                <tr>
                                    <td class="font-monospace small">@t.TableName</td>
                                    <td>@(string.IsNullOrWhiteSpace(t.DisplayName) ? "-" : t.DisplayName)</td>
                                    <td class="small">@(string.IsNullOrWhiteSpace(t.SerialColumn) ? "-" : t.SerialColumn)</td>
                                    <td class="small">@(string.IsNullOrWhiteSpace(t.DateColumn) ? "-" : t.DateColumn)</td>
                                    <td class="text-end">
                                        <a href="/query" class="btn btn-sm btn-outline-primary">Consultar</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    bool IsLoading = true;
    Dictionary<string, List<TablaConfigDto>> Groups = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        IsLoading = true;
        try
        {
            var cfg = await TablasService.GetConfigAsync();
            Groups = cfg
                .GroupBy(c => string.IsNullOrWhiteSpace(c.Fuente) ? "Sin clasificar" : c.Fuente!)
                .ToDictionary(g => g.Key, g => g.OrderBy(c => c.TableName).ToList(), StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex) { /* ignore */ }
        finally { IsLoading = false; }
    }
}