@page "/configuration"
@attribute [Authorize(Roles = "Administrador")]
@using Microsoft.AspNetCore.Authorization
@using SXA.RTX.Analytics.Application.Abstractions
@using SXA.RTX.Analytics.Domain.Enums
@inject ISystemTableService SystemService
@inject IEquipoService EquipoService
@inject ITablasConfigService TablasService
@inject IDynamicQueryService QueryService
@inject IConfigExportService ExportService
@inject IDataSourceService DataSources
@inject IConfigurationService Settings
@inject IJSRuntime JS

<PageTitle>Configuración — SXA-RTX Analytics</PageTitle>

<div class="d-flex flex-wrap gap-3 align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-1" style="font-weight:800; letter-spacing:-.02em">Configuración</h2>
        <div class="text-muted small">SQL Server (solo lectura) • MAPICS (ODBC) • Almacenamiento local • Equipos • Tablas y fuentes</div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="rtx-pill rtx-pill--sky">SQL solo lectura</span>
        <span class="rtx-pill rtx-pill--honey">DeviceId PC-...</span>
    </div>
</div>

<ul class="nav nav-pills mb-4 flex-wrap" role="tablist">
    <li class="nav-item"><button class="nav-link @(ActiveTab==0?"active":"")" @onclick="() => ActiveTab=0">SQL Server</button></li>
    <li class="nav-item"><button class="nav-link @(ActiveTab==1?"active":"")" @onclick="() => ActiveTab=1">MAPICS (ODBC)</button></li>
    <li class="nav-item"><button class="nav-link @(ActiveTab==2?"active":"")" @onclick="() => ActiveTab=2">Almacenamiento</button></li>
    <li class="nav-item"><button class="nav-link @(ActiveTab==3?"active":"")" @onclick="async () => { ActiveTab=3; await LoadEquipos(); }">Equipos</button></li>
    <li class="nav-item"><button class="nav-link @(ActiveTab==4?"active":"")" @onclick="async () => { ActiveTab=4; await LoadTablas(); }">Tablas y fuentes</button></li>
    <li class="nav-item"><button class="nav-link @(ActiveTab==5?"active":"")" @onclick="() => ActiveTab=5">Import/Export</button></li>
</ul>

@if (ActiveTab == 0)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">SQL Server — conexión de la plataforma</h5>
            <p class="text-muted small">Conexión de <strong>solo lectura</strong> a la base de producción: contiene las tablas operativas VTI/VTech que consulta <code>/query</code> y el catálogo <code>dbo.SXA_PCs</code>. La configuración de la app se guarda localmente (SQLite), no en esta base.</p>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Servidor</label><input class="form-control" @bind="SqlServer" placeholder="10.96.16.114" /></div>
                <div class="col-md-3"><label class="form-label">Autenticación</label><select class="form-select" @bind="SqlAuth"><option value="sql">SQL Server</option><option value="win">Windows</option></select></div>
                <div class="col-md-3 d-flex align-items-end gap-2"><div class="form-check"><input class="form-check-input" type="checkbox" @bind="SqlEncrypt" id="enc"><label class="form-check-label" for="enc">Encrypt</label></div><div class="form-check"><input class="form-check-input" type="checkbox" @bind="SqlTrust" id="trust"><label class="form-check-label" for="trust">Trust cert</label></div></div>
                <div class="col-md-6"><label class="form-label">Base de datos</label><input class="form-control" @bind="SqlDatabase" placeholder="hussmann_Insight" /></div>
                <div class="col-md-3"><label class="form-label">Usuario</label><input class="form-control" @bind="SqlUser" disabled="@(SqlAuth=="win")" /></div>
                <div class="col-md-3"><label class="form-label">Contraseña</label><input type="password" class="form-control" @bind="SqlPassword" disabled="@(SqlAuth=="win")" /></div>
                <div class="col-12"><label class="form-label">Cadena resultante (la contraseña no se muestra)</label><input class="form-control font-monospace small" value="@BuildSqlConnectionString()" readonly /></div>
            </div>
            <div class="d-flex gap-2 mt-3 flex-wrap align-items-center">
                <button class="btn btn-outline-primary" @onclick="TestSql" disabled="@IsTestingSql">@if (IsTestingSql) { <span class="spinner-border spinner-border-sm"></span> @(" Probando...") } else { @("Probar conexión") }</button>
                <button class="btn btn-outline-secondary" @onclick="LoadDatabases" disabled="@(!SqlTestOk)">Cargar bases (carpetas)</button>
                <button class="btn btn-primary" @onclick="SaveConnections" disabled="@IsSavingConnections">@if (IsSavingConnections) { <span class="spinner-border spinner-border-sm"></span> @(" Guardando...") } else { @("Guardar conexión") }</button>
                <button class="btn btn-outline-secondary" @onclick="async () => { ActiveTab=3; await LoadEquipos(); }">Ir a Equipos →</button>
            </div>
            @if (!string.IsNullOrEmpty(SqlTestMsg)) { <div class="alert @(SqlTestOk ? "alert-success" : "alert-danger") mt-3 py-2 small">@SqlTestMsg</div> }
            @if (!string.IsNullOrEmpty(SaveConnMsg)) { <div class="alert @(SaveConnOk ? "alert-success" : "alert-danger") mt-3 py-2 small">@SaveConnMsg</div> }
            @if (Databases.Count > 0) { <hr /><h6>Carpetas / Bases disponibles</h6><div class="row g-2">@foreach (var db in Databases) { <div class="col-md-4"><label class="d-flex align-items-center gap-2 border rounded-3 p-2 bg-white"><input type="checkbox" @bind="db.IsSelected" /><span class="small">@db.Name</span></label></div> }</div><div class="text-muted small mt-2">@Databases.Count(b => b.IsSelected) seleccionadas</div> }
        </div>
    </div>
}
else if (ActiveTab == 1)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">MAPICS — ODBC</h5>
            <p class="text-muted small">Dataset ODBC para MAPICS. Se usará <code>OdbcDataSourceProvider</code>.</p>
            <label class="form-label">Cadena ODBC</label><input class="form-control font-monospace small" @bind="OdbcConnectionString" placeholder="DSN=MAPICS;UID=...;PWD=...;" />
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3"><button class="btn btn-primary" @onclick="TestOdbc" disabled="@IsTestingOdbc">@if (IsTestingOdbc) { <span class="spinner-border spinner-border-sm"></span> @(" Probando...") } else { @("Probar ODBC") }</button></div>
            @if (!string.IsNullOrEmpty(OdbcTestMsg)) { <div class="alert @(OdbcTestOk ? "alert-success" : "alert-danger") mt-3 py-2 small">@OdbcTestMsg</div> }
        </div>
    </div>
}
else if (ActiveTab == 2)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Almacenamiento de configuración</h5>
            <p class="text-muted small">La base SQL de producción es <strong>solo lectura</strong>: la aplicación nunca crea, altera ni escribe tablas en ella.</p>
            <ul class="text-muted small mb-0">
                <li>Usuarios, fuentes, títulos, nicknames, relaciones y ajustes se guardan en un archivo <strong>SQLite local</strong>: <code>data/sxa-config.db</code> (junto a la aplicación).</li>
                <li>Las conexiones SQL/ODBC se guardan cifradas con DPAPI en ese mismo archivo.</li>
                <li>Para respaldar o mover la configuración entre equipos usa <strong>Import/Export</strong>.</li>
            </ul>
        </div>
    </div>
}
else if (ActiveTab == 3)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Equipos — mapeo <code>DeviceId (PC-...)</code> → Nombre + Área</h5>
            <p class="text-muted small">El <code>DeviceId</code> y <code>Tipo (VTI/VTech)</code> se traen del central de Sync (<code>dbo.SXA_PCs.TipoMaquina</code>). Aquí solo asignas <strong>Nombre</strong> y <strong>Área</strong>. Se usa en toda la app.</p>

            <div class="row g-3 p-3 border rounded-3 bg-light">
                <div class="col-md-4">
                    <label class="form-label">DeviceId (PC-...)</label>
                    <select class="form-select font-monospace small" @bind="EqDeviceId">
                        <option value="">— selecciona —</option>
                        @foreach (var d in Catalog)
                        {
                            <option value="@d.DeviceId">@d.DeviceId — @d.NombrePC (@d.TipoMaquina)</option>
                        }
                    </select>
                    <div class="form-text">Trae Tipo automático.</div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tipo (solo lectura)</label>
                    <input class="form-control" value="@Catalog.FirstOrDefault(x=>x.DeviceId==EqDeviceId)?.TipoMaquina" readonly />
                </div>
                <div class="col-md-3"><label class="form-label">Nombre</label><input class="form-control" @bind="EqNombre" placeholder="Ej. Línea 3 - Celda 1" /></div>
                <div class="col-md-3"><label class="form-label">Área</label><input class="form-control" @bind="EqArea" placeholder="Ej. Producción / HVAC" list="areasList" /><datalist id="areasList">@foreach (var a in Areas.Distinct()) { <option value="@a"></option> }</datalist></div>
                <div class="col-12 d-flex flex-wrap align-items-center gap-2">
                    <button class="btn btn-primary" @onclick="SaveEquipo" disabled="@IsSavingEquipo">@if (IsSavingEquipo) { <span class="spinner-border spinner-border-sm"></span> } else { @("Guardar") }</button>
                    <button class="btn btn-outline-secondary" @onclick="LoadEquipos">Recargar</button>
                </div>
                @if (!string.IsNullOrEmpty(EqMsg)) { <div class="col-12"><div class="alert @(EqOk?"alert-success":"alert-danger") py-2 small mb-0">@EqMsg</div></div> }
            </div>

            @if (IsLoadingEquipos) { <div class="text-center py-3"><div class="spinner-border"></div></div> }
            else
            {
                <div class="row g-3 mt-1">
                    @foreach (var tipo in new[] { "VTI", "VTech" })
                    {
                        <div class="col-lg-6">
                            <h6 class="mt-2"><span class="rtx-pill @(tipo=="VTI"?"rtx-pill--sky":"rtx-pill--honey")">@tipo</span> <span class="text-muted small">— @GetCount(tipo, true) con nombre / @GetCount(tipo, false) sin nombre</span></h6>
                            <div class="card">
                                <div class="card-header py-2 small fw-bold">Con nombre</div>
                                <div class="table-responsive"><table class="table table-sm small mb-0"><thead><tr><th>DeviceId</th><th>Nombre</th><th>Área</th><th></th></tr></thead><tbody>
                                    @foreach (var e in GetEquiposByTipo(tipo, true))
                                    {
                                        <tr><td class="font-monospace" style="font-size:.75rem">@e.DeviceId</td><td>@e.Nombre</td><td><span class="badge bg-light text-dark border">@e.Area</span></td><td><button class="btn btn-xs btn-outline-primary" @onclick="() => { EqDeviceId=e.DeviceId; EqNombre=e.Nombre; EqArea=e.Area; }">Editar</button></td></tr>
                                    }
                                    @if (!GetEquiposByTipo(tipo, true).Any()) { <tr><td colspan="4" class="text-center text-muted py-2">Sin equipos con nombre</td></tr> }
                                </tbody></table></div>
                            </div>
                            <div class="card mt-2">
                                <div class="card-header py-2 small fw-bold">Sin nombre (pendientes)</div>
                                <div class="table-responsive"><table class="table table-sm small mb-0"><thead><tr><th>DeviceId</th><th>NombrePC sync</th><th></th></tr></thead><tbody>
                                    @foreach (var c in GetCatalogByTipo(tipo, false))
                                    {
                                        <tr><td class="font-monospace" style="font-size:.75rem">@c.DeviceId</td><td class="text-muted">@c.NombrePC</td><td><button class="btn btn-xs btn-outline-primary" @onclick="() => EqDeviceId=c.DeviceId">Asignar</button></td></tr>
                                    }
                                    @if (!GetCatalogByTipo(tipo, false).Any()) { <tr><td colspan="3" class="text-center text-muted py-2">Todos con nombre ✓</td></tr> }
                                </tbody></table></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else if (ActiveTab == 4)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Tablas y fuentes</h5>
            <p class="text-muted small">Marca las tablas que usa Analytics, asígnalas a una <strong>fuente</strong> (VTI, Packout, Cajas, Producción...), ponles título y nickname a las columnas, e indica qué columna es el <strong>número de serie</strong> y cuál la <strong>fecha</strong> (para la línea de tiempo).</p>
            <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadTablas" disabled="@IsLoadingTablas">@if (IsLoadingTablas) { <span class="spinner-border spinner-border-sm"></span> } else { @("Cargar tablas") }</button>
                <button class="btn btn-primary btn-sm" @onclick="SaveTablas" disabled="@IsSavingTablas">Guardar</button>
                <span class="text-muted small ms-1">@SelectedCount() tabla(s) seleccionada(s)</span>
            </div>
            @if (!string.IsNullOrEmpty(TablasMsg)) { <div class="alert @(TablasOk?"alert-success":"alert-danger") py-2 small">@TablasMsg</div> }
            @if (AllTables.Count == 0) { <div class="text-muted small">Pulsa “Cargar tablas” (usa la cadena SQL de la pestaña SQL Server).</div> }
            else
            {
                <datalist id="fuentesList">@foreach (var f in FuentesSugeridas) { <option value="@f"></option> }</datalist>
                <div class="table-responsive"><table class="table table-sm small align-middle">
                    <thead><tr><th style="width:44px" class="text-center">Usar</th><th style="width:30%">Tabla SQL</th><th style="width:18%">Fuente</th><th style="width:22%">Título</th><th class="text-center">Columnas</th></tr></thead>
                    <tbody>
                    @foreach (var t in AllTables)
                    {
                        var e = Edit(t);
                        <tr>
                            <td class="text-center"><input type="checkbox" checked="@e.Used" @onchange="ev => SetUsed(t, (bool)(ev.Value ?? false))" /></td>
                            <td class="font-monospace" style="word-break:break-all">@t</td>
                            <td><input class="form-control form-control-sm" list="fuentesList" value="@e.Fuente" placeholder="VTI, Packout..." @onchange="ev => SetFuente(t, ev.Value?.ToString())" /></td>
                            <td><input class="form-control form-control-sm" value="@e.Title" placeholder="@t" @onchange="ev => SetTitle(t, ev.Value?.ToString())" /></td>
                            <td class="text-center">
                                <button class="btn btn-sm @(e.Columns.Count>0 ? "btn-outline-primary" : "btn-outline-secondary")" @onclick="() => LoadColumns(t)">
                                    @if (LoadingColumns.Contains(t)) { <span class="spinner-border spinner-border-sm"></span> }
                                    else if (e.Columns.Count > 0) { @($"{e.Visible.Count}/{e.Columns.Count}") }
                                    else { @("Columnas") }
                                </button>
                            </td>
                        </tr>
                        @if (e.Columns.Count > 0)
                        {
                            <tr class="bg-light">
                                <td colspan="5" class="py-2">
                                    <div class="d-flex flex-wrap gap-3 mb-2">
                                        <div>
                                            <label class="form-label small mb-1">Columna serie</label>
                                            <select class="form-select form-select-sm" value="@e.Serial" @onchange="ev => SetSerial(t, ev.Value?.ToString())">
                                                <option value="">—</option>
                                                @foreach (var c in e.Columns) { <option value="@c.Name">@c.Name</option> }
                                            </select>
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Columna fecha</label>
                                            <select class="form-select form-select-sm" value="@e.DateCol" @onchange="ev => SetDate(t, ev.Value?.ToString())">
                                                <option value="">—</option>
                                                @foreach (var c in e.Columns) { <option value="@c.Name">@c.Name</option> }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var c in e.Columns)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="checkbox" checked="@e.Visible.Contains(c.Name)" @onchange="ev => SetVisible(t, c.Name, (bool)(ev.Value ?? false))" />
                                                <span class="font-monospace" style="font-size:.75rem; min-width:190px">@c.Name</span>
                                                <span class="text-muted" style="font-size:.65rem; min-width:70px">@c.DataType</span>
                                                <input class="form-control form-control-sm" style="max-width:240px" value="@e.Nicks.GetValueOrDefault(c.Name)" placeholder="nickname" @onchange="ev => SetNick(t, c.Name, ev.Value?.ToString())" />
                                            </div>
                                        }
                                    </div>
                                    <div class="form-text mb-0">Sin columnas marcadas = se muestran todas. El nickname reemplaza el nombre real en la app y en las exportaciones.</div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
}
else if (ActiveTab == 5)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Import / Export — respaldo de configuración</h5>
            <p class="text-muted small">Descarga toda la configuración (<code>Equipos, Tablas VTI/VTech, Tablas sistema, ApplicationSettings, Usuarios</code>) en un JSON. Cada nueva sección que agreguemos se incluirá automáticamente aquí.</p>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button class="btn btn-primary" @onclick="Exportar" disabled="@IsExporting">@if (IsExporting) { <span class="spinner-border spinner-border-sm"></span> @(" Exportando...") } else { @("Descargar JSON") }</button>
                <label class="btn btn-outline-primary mb-0">
                    Cargar JSON <InputFile OnChange="Importar" accept=".json" style="display:none" />
                </label>
            </div>
            @if (!string.IsNullOrEmpty(ImportExportMsg)) { <div class="alert @(ImportExportOk?"alert-success":"alert-danger") mt-3 py-2 small">@ImportExportMsg</div> }
            @if (!string.IsNullOrEmpty(ExportPreview)) { <pre class="mt-3 p-3 bg-light border rounded small" style="max-height:300px;overflow:auto">@ExportPreview</pre> }
        </div>
    </div>
}

@code {
    int ActiveTab = 0;

    // SQL (única conexión)
    string SqlServer = "10.96.16.114"; string SqlDatabase = "hussmann_Insight"; string SqlAuth = "sql"; string SqlUser = "HInsightUser"; string SqlPassword = ""; bool SqlEncrypt = true; bool SqlTrust = true;
    bool IsTestingSql = false; bool SqlTestOk = false; string? SqlTestMsg; List<DatabaseOptionMutable> Databases = new();
    bool IsSavingConnections = false; string? SaveConnMsg; bool SaveConnOk; bool ConnectionsLoaded;

    // ODBC
    string OdbcConnectionString = "DSN=MAPICS;"; bool IsTestingOdbc = false; bool OdbcTestOk = false; string? OdbcTestMsg;

    // Equipos
    List<CatalogDeviceDto> Catalog = new(); List<EquipoDto> Equipos = new(); bool IsLoadingEquipos = false;
    string EqDeviceId = ""; string EqNombre = ""; string EqArea = ""; bool IsSavingEquipo = false; string? EqMsg; bool EqOk = false;
    List<string> Areas => Equipos.Select(e => e.Area).Distinct().ToList();

    // Tablas y fuentes
    public sealed class TableEdit
    {
        public bool Used;
        public string Fuente = "";
        public string Title = "";
        public string Serial = "";
        public string DateCol = "";
        public List<ColumnInfo> Columns = new();
        public HashSet<string> Visible = new(StringComparer.OrdinalIgnoreCase);
        public Dictionary<string, string> Nicks = new(StringComparer.OrdinalIgnoreCase);
    }
    List<string> AllTables = new();
    Dictionary<string, TableEdit> Edits = new(StringComparer.OrdinalIgnoreCase);
    bool IsLoadingTablas = false; bool IsSavingTablas = false; string? TablasMsg; bool TablasOk = false;
    HashSet<string> LoadingColumns = new(StringComparer.OrdinalIgnoreCase);
    static readonly string[] FuentesSugeridas = { "VTI", "Producción", "Packout", "Cajas", "Cabeceras", "Alarmas", "Logs", "Catálogos", "Equipos" };

    // Import/Export
    bool IsExporting = false; bool IsImporting = false; string? ImportExportMsg; bool ImportExportOk = false; string? ExportPreview;

    protected override async Task OnInitializedAsync() { await LoadConnections(); await LoadEquipos(); }

    // Contraseña leída de la conexión configurada. No se muestra en el formulario,
    // pero se usa para construir la cadena mientras el admin no escriba otra.
    string _savedPassword = "";

    string BuildSqlConnectionString() => SqlAuth=="win" ? $"Server={SqlServer};Database={SqlDatabase};Trusted_Connection=True;Encrypt={(SqlEncrypt?"True":"False")};TrustServerCertificate={(SqlTrust?"True":"False")};" : $"Server={SqlServer};Database={SqlDatabase};User Id={SqlUser};Password=***;Encrypt={(SqlEncrypt?"True":"False")};TrustServerCertificate={(SqlTrust?"True":"False")};";
    string BuildSqlConnectionStringReal()
    {
        if (SqlAuth == "win")
            return $"Server={SqlServer};Database={SqlDatabase};Trusted_Connection=True;Encrypt={(SqlEncrypt?"True":"False")};TrustServerCertificate={(SqlTrust?"True":"False")};";
        var pwd = string.IsNullOrEmpty(SqlPassword) ? _savedPassword : SqlPassword;
        return $"Server={SqlServer};Database={SqlDatabase};User Id={SqlUser};Password={pwd};Encrypt={(SqlEncrypt?"True":"False")};TrustServerCertificate={(SqlTrust?"True":"False")};";
    }

    // Rellena los campos con lo ya guardado (o lo que haya en appsettings). La
    // contraseña no se muestra; se conserva internamente para no romper la conexión.
    async Task LoadConnections()
    {
        try
        {
            var s = await DataSources.GetAsync();
            ApplyConnectionString(s.ConfigurationConnectionString);
            OdbcConnectionString = s.OdbcConnectionString ?? OdbcConnectionString;
            ConnectionsLoaded = true;
        }
        catch { /* la app arranca igual con appsettings */ }
    }

    void ApplyConnectionString(string? cs)
    {
        if (string.IsNullOrWhiteSpace(cs)) return;
        try
        {
            var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(cs);
            SqlServer = b.DataSource;
            SqlDatabase = b.InitialCatalog;
            SqlUser = b.UserID ?? "";
            SqlAuth = b.IntegratedSecurity ? "win" : "sql";
            SqlEncrypt = b.Encrypt;
            SqlTrust = b.TrustServerCertificate;
            _savedPassword = b.Password ?? "";
        }
        catch { /* cadena no parseable: se deja lo que haya */ }
    }

    async Task SaveConnections()
    {
        IsSavingConnections = true; SaveConnMsg = null;
        try
        {
            // Una sola base: se guarda como conexión de configuración y /query la reutiliza.
            await DataSources.SaveAsync(BuildSqlConnectionStringReal(), null, OdbcConnectionString);
            SaveConnOk = true;
            SaveConnMsg = "Conexión guardada (cifrada con DPAPI en la base de datos).";
            ConnectionsLoaded = true;
        }
        catch (Exception ex) { SaveConnOk = false; SaveConnMsg = "No se pudo guardar: " + ex.Message; }
        finally { IsSavingConnections = false; }
    }

    async Task TestSql(){ IsTestingSql=true; SqlTestMsg=null; var (ok,msg)=await SystemService.TestSqlConnectionAsync(BuildSqlConnectionStringReal()); SqlTestOk=ok; SqlTestMsg=msg; IsTestingSql=false; }
    async Task LoadDatabases(){ var list=await SystemService.ListDatabasesAsync(BuildSqlConnectionStringReal()); Databases=list.Select(n=>new DatabaseOptionMutable{Name=n}).ToList(); }
    async Task TestOdbc(){ IsTestingOdbc=true; OdbcTestMsg=null; var (ok,msg)=await SystemService.TestOdbcConnectionAsync(OdbcConnectionString); OdbcTestOk=ok; OdbcTestMsg=msg; IsTestingOdbc=false; }
    
    async Task LoadEquipos(){
        IsLoadingEquipos=true;
        try
        {
        var cs = BuildSqlConnectionStringReal();
        Catalog = (await EquipoService.GetCatalogAsync(cs)).ToList();
        Equipos = (await EquipoService.GetEquiposAsync()).ToList();
        // Merge Tipo from catalog
        var map = Catalog.GroupBy(c=>c.DeviceId).ToDictionary(g=>g.Key, g=>g.First());
        for(int i=0;i<Equipos.Count;i++){ var e=Equipos[i]; if(map.TryGetValue(e.DeviceId, out var c)){ var tipo = c.TipoMaquina?.Equals("VTech", StringComparison.OrdinalIgnoreCase)==true ? EquipoTipo.VTech : c.TipoMaquina?.Equals("VTI", StringComparison.OrdinalIgnoreCase)==true ? EquipoTipo.VTI : (EquipoTipo?)null; Equipos[i]= e with{ TipoSync=tipo, NombrePCSync=c.NombrePC, UltimoContacto=c.UltimoContacto }; } }
        }
        finally { IsLoadingEquipos=false; }
    }
    async Task SaveEquipo(){ IsSavingEquipo=true; EqMsg=null; var tipo = Catalog.FirstOrDefault(x=>x.DeviceId==EqDeviceId)?.TipoMaquina; var (ok,msg)=await EquipoService.UpsertAsync(EqDeviceId, EqNombre, EqArea, tipo); EqOk=ok; EqMsg=msg; IsSavingEquipo=false; if(ok) await LoadEquipos(); }
    int GetCount(string tipo, bool conNombre){ var set = Equipos.Where(e=> (e.TipoSync?.ToString()??"")==tipo).Select(e=>e.DeviceId).ToHashSet(); var cat = Catalog.Where(c=> (c.TipoMaquina??"")==tipo).Select(c=>c.DeviceId).ToHashSet(); return conNombre ? set.Count : cat.Except(set).Count(); }
    IEnumerable<EquipoDto> GetEquiposByTipo(string tipo, bool conNombre){ var filtered = Equipos.Where(e=> (e.TipoSync?.ToString()??"")==tipo); return conNombre ? filtered : Enumerable.Empty<EquipoDto>(); }
    IEnumerable<CatalogDeviceDto> GetCatalogByTipo(string tipo, bool _con){ var eqSet = Equipos.Select(e=>e.DeviceId).ToHashSet(); return Catalog.Where(c=> (c.TipoMaquina??"")==tipo && !eqSet.Contains(c.DeviceId)); }

    TableEdit Edit(string t)
    {
        if (!Edits.TryGetValue(t, out var e)) { e = new TableEdit(); Edits[t] = e; }
        return e;
    }
    int SelectedCount() => Edits.Values.Count(e => e.Used);
    void SetUsed(string t, bool v) => Edit(t).Used = v;
    void SetFuente(string t, string? v) => Edit(t).Fuente = v ?? "";
    void SetTitle(string t, string? v) => Edit(t).Title = v ?? "";
    void SetSerial(string t, string? v) => Edit(t).Serial = v ?? "";
    void SetDate(string t, string? v) => Edit(t).DateCol = v ?? "";
    void SetVisible(string t, string col, bool on) { var e = Edit(t); if (on) e.Visible.Add(col); else e.Visible.Remove(col); }
    void SetNick(string t, string col, string? v)
    {
        var e = Edit(t);
        if (string.IsNullOrWhiteSpace(v)) e.Nicks.Remove(col); else e.Nicks[col] = v.Trim();
    }

    async Task LoadTablas(){ IsLoadingTablas=true; try {
        AllTables=(await TablasService.ListAllTablesAsync(BuildSqlConnectionStringReal())).ToList();
        var cfg=await TablasService.GetConfigAsync();
        Edits = new Dictionary<string, TableEdit>(StringComparer.OrdinalIgnoreCase);
        foreach (var c in cfg)
        {
            var e = new TableEdit { Used = true, Fuente = c.Fuente ?? "", Title = c.DisplayName ?? "", Serial = c.SerialColumn ?? "", DateCol = c.DateColumn ?? "" };
            foreach (var col in c.Columnas)
            {
                e.Columns.Add(new ColumnInfo(col.ColumnName, "", true));
                e.Visible.Add(col.ColumnName);
                if (!string.IsNullOrWhiteSpace(col.DisplayName)) e.Nicks[col.ColumnName] = col.DisplayName!;
            }
            Edits[c.TableName] = e;
        }
        foreach (var t in AllTables) Edit(t);
    } finally { IsLoadingTablas=false; } }

    async Task LoadColumns(string t){
        LoadingColumns.Add(t);
        try
        {
            var cols = (await QueryService.GetColumnsAsync(BuildSqlConnectionStringReal(), t)).ToList();
            var e = Edit(t);
            e.Columns = cols;
            if (e.Visible.Count == 0) foreach (var c in cols) e.Visible.Add(c.Name);
        }
        finally { LoadingColumns.Remove(t); }
    }

    async Task SaveTablas(){
        IsSavingTablas=true; TablasMsg=null;
        try {
            var dtos = Edits.Where(kv => kv.Value.Used).Select(kv =>
            {
                var e = kv.Value;
                var cols = e.Columns
                    .Where(c => e.Visible.Contains(c.Name) || e.Nicks.ContainsKey(c.Name))
                    .Select(c => new TablaColumnaDto(c.Name, e.Nicks.GetValueOrDefault(c.Name)))
                    .ToList();
                return new TablaConfigDto(
                    kv.Key,
                    string.IsNullOrWhiteSpace(e.Fuente) ? "Sin clasificar" : e.Fuente.Trim(),
                    string.IsNullOrWhiteSpace(e.Title) ? null : e.Title.Trim(),
                    string.IsNullOrWhiteSpace(e.Serial) ? null : e.Serial,
                    string.IsNullOrWhiteSpace(e.DateCol) ? null : e.DateCol,
                    cols);
            }).ToList();
            var (ok,msg)=await TablasService.SaveAsync(dtos);
            TablasOk=ok; TablasMsg=msg;
        } catch(Exception ex){ TablasOk=false; TablasMsg="No se pudo guardar: "+ex.Message; }
        finally { IsSavingTablas=false; }
    }

    async Task Exportar(){
        IsExporting=true; ImportExportMsg=null;
        var json = await ExportService.ExportJsonAsync();
        ExportPreview = json.Length > 4000 ? json.Substring(0,4000)+"..." : json;
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $"var a=document.createElement('a');a.href='data:application/json;base64,{b64}';a.download='sxa-rtx-config-'+new Date().toISOString().slice(0,10)+'.json';document.body.appendChild(a);a.click();a.remove();");
        ImportExportOk=true; ImportExportMsg="Descargado. Incluye Equipos, Tablas VTI/VTech, Tablas sistema, Settings y Usuarios."; IsExporting=false;
    }
    async Task Importar(InputFileChangeEventArgs e){
        IsImporting=true; ImportExportMsg=null;
        try {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5*1024*1024);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var (ok,msg)=await ExportService.ImportJsonAsync(json);
            ImportExportOk=ok; ImportExportMsg=msg;
            if(ok){ await LoadEquipos(); await LoadTablas(); }
        } catch(Exception ex){ ImportExportOk=false; ImportExportMsg=ex.Message; }
        IsImporting=false;
    }

    class DatabaseOptionMutable { public string Name { get; set; }=""; public bool IsSelected { get; set; } }
