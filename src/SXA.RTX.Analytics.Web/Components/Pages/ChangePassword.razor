@page "/account/password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SXA.RTX.Analytics.Application.Abstractions
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Cambiar contraseña — SXA-RTX Analytics</PageTitle>

<div class="d-flex justify-content-center mt-5">
    <div class="card" style="max-width:460px; width:100%">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1">Cambia tu contraseña</h4>
            <p class="text-muted small mb-3">Por seguridad debes definir una contraseña nueva antes de continuar.</p>

            <div class="mb-3">
                <label class="form-label small fw-bold">Contraseña actual</label>
                <input type="password" class="form-control" @bind="Current" @bind:event="oninput" autocomplete="current-password" />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-bold">Nueva contraseña</label>
                <input type="password" class="form-control" @bind="NewPassword" @bind:event="oninput" autocomplete="new-password" />
                <div class="form-text">Mínimo 8 caracteres.</div>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-bold">Confirmar nueva contraseña</label>
                <input type="password" class="form-control" @bind="Confirm" @bind:event="oninput" autocomplete="new-password" />
            </div>

            @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger py-2 small">@Error</div> }
            @if (!string.IsNullOrEmpty(OkMsg)) { <div class="alert alert-success py-2 small">@OkMsg</div> }

            <button class="btn btn-primary w-100" @onclick="Submit" disabled="@IsBusy">
                @if (IsBusy) { <span class="spinner-border spinner-border-sm"></span> } else { @("Guardar y continuar") }
            </button>
        </div>
    </div>
</div>

@code {
    string Current = ""; string NewPassword = ""; string Confirm = ""; string? Error; string? OkMsg; bool IsBusy;

    async Task Submit()
    {
        Error = null; OkMsg = null; IsBusy = true;
        try
        {
            if (NewPassword != Confirm) { Error = "Las contraseñas no coinciden."; IsBusy = false; return; }
            var auth = await AuthState.GetAuthenticationStateAsync();
            var username = auth.User.Identity?.Name;
            if (string.IsNullOrWhiteSpace(username)) { Error = "Sesión inválida, vuelve a entrar."; IsBusy = false; return; }

            var res = await AuthService.ChangePasswordAsync(username, Current, NewPassword);
            if (!res.Success) { Error = res.Message; IsBusy = false; return; }

            OkMsg = "Contraseña actualizada — vuelve a entrar...";
            // Cierra la sesión y vuelve al login para entrar con la contraseña nueva.
            Nav.NavigateTo("/logout", forceLoad: true);
        }
        catch (Exception ex) { Error = ex.Message; IsBusy = false; }
    }
}