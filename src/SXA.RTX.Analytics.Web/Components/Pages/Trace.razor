@page "/trace"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SXA.RTX.Analytics.Application.Abstractions
@inject ITraceService TraceService
@inject ITablasConfigService TablasService
@inject IDataSourceService DataSources
@inject IConfigurationService Settings
@inject ITraceReportService ReportService
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@using Microsoft.AspNetCore.Hosting

<PageTitle>Trazabilidad — SXA-RTX Analytics</PageTitle>

<div class="rx-page-head">
    <div>
        <div class="rx-eyebrow">Trazabilidad</div>
        <h1>Línea de tiempo por número de serie</h1>
        <div class="text-muted small">Historial del producto a través de todas las fuentes configuradas.</div>
    </div>
    <button class="btn btn-outline-primary" @onclick="GenerarReporte" disabled="@(Events.Count == 0 || IsGenerating)">
        @if (IsGenerating) { <span class="spinner-border spinner-border-sm"></span> } else { <Icon Name="file-pdf" Size="16" /> }
        Generar reporte
    </button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-8 col-lg-9">
                <label class="form-label small fw-bold">Número de serie</label>
                <input class="form-control font-monospace" @bind="Serial" @bind:event="oninput" placeholder="Ej. MY26L083473" @onkeydown="OnKey" />
            </div>
            <div class="col-md-4 col-lg-3">
                <button class="btn btn-primary w-100" @onclick="Buscar" disabled="@IsSearching">
                    @if (IsSearching) { <span class="spinner-border spinner-border-sm"></span> } else { <Icon Name="search" Size="16" /> } Buscar
                </button>
            </div>
        </div>
        <div class="form-text mt-2">Busca en todas las fuentes y tablas configuradas.</div>
        @if (!string.IsNullOrEmpty(Msg)) { <div class="alert alert-danger mt-3 py-2 small mb-0">@Msg</div> }
    </div>
</div>

@if (Searched)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">Eventos</span><span class="rx-kpi__value">@Events.Count</span>
        </div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">Fuentes</span><span class="rx-kpi__value">@Lanes.Count</span>
        </div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">Primer evento</span><span class="rx-kpi__value" style="font-size:1.05rem">@(Min?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
        </div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">Duración</span><span class="rx-kpi__value" style="font-size:1.05rem">@DurationText</span>
        </div></div></div>
    </div>

    @if (Events.Count == 0)
    {
        <div class="card"><div class="card-body text-center text-muted py-5">
            <Icon Name="search" Size="28" />
            <div class="mt-2">No se encontraron eventos para ese número de serie.</div>
            <div class="small mt-1">Verifica que las tablas tengan configurada la columna serie y fecha en Configuración → Tablas y fuentes.</div>
        </div></div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                <span>Línea de tiempo <span class="text-muted small">· @SearchedSerial</span></span>
                <span class="text-muted small">@Events.Count eventos · escala automática</span>
            </div>
            <div class="card-body">
                <div class="tl-window">
                    <div class="tl" style="min-width:@(TimelineMinWidth)px">
                        <div class="tl-axis">
                            @foreach (var tick in Ticks) { <span class="tl-tick" style="left:@(TickPct(tick).ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%">@FormatTick(tick)</span> }
                        </div>
                        @foreach (var lane in Lanes)
                        {
                            var dots = Layout.TryGetValue(lane.Key, out var placed) ? placed : lane.Value.Select(e => new DotPos(e, new List<TraceEventDto> { e }, Pct(e), 0, 1)).ToList();
                            var rows = dots.Count == 0 ? 1 : dots.Max(d => d.Row) + 1;
                            var trackH = 46 + (rows - 1) * 18;
                            <div class="tl-lane">
                                <div class="tl-label" title="@lane.Key">@lane.Key <span class="tl-count">@lane.Value.Count</span></div>
                                <div class="tl-track" style="height:@(trackH)px">
                                    @foreach (var dot in dots)
                                    {
                                        var ev = dot.Event;
                                        var center = trackH / 2.0 + (dot.Row - (rows - 1) / 2.0) * 18;
                                        var cluster = dot.Count > 1;
                                        <button class="tl-dot @(cluster ? "tl-dot--cluster" : "") @(Selected is not null && dot.Events.Contains(Selected) ? "is-selected" : "")"
                                                style="left:@dot.Left.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)%;top:@center.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)px"
                                                @onclick="() => Pick(dot)"
                                                title="@(cluster ? $"{dot.Count} eventos · {ev.OccurredAt:yyyy-MM-dd HH:mm:ss} · clic para recorrerlos" : $"{ev.OccurredAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "sin fecha"} - {ev.TableDisplayName}")">@(cluster ? dot.Count.ToString() : "")</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-3 mt-2 small text-muted">
                    <span>Haz clic en un punto para ver el detalle.</span>
                </div>
            </div>
        </div>

        @if (Selected is not null)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@Selected.TableDisplayName <span class="text-muted small">· @Selected.Fuente</span></span>
                    <span class="text-muted small">@(Selected.OccurredAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "sin fecha")</span>
                </div>
                <div class="card-body">
                    <dl class="rx-detail">
                        @foreach (var item in Detail(Selected)) { <div><dt>@item.Key</dt><dd>@item.Value</dd></div> }
                    </dl>

                    @if (Selected.Details is { Count: > 0 })
                    {
                        var spec = DetailSpecFor(Selected);
                        <hr />
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Resultados de pruebas <span class="text-muted small">(@Selected.Details.Count)</span></h6>
                            <span class="small text-muted">Aprobadas: <strong>@PassedCount(Selected)</strong> · Fallidas: <strong>@FailedCount(Selected)</strong></span>
                        </div>
                        <div class="table-responsive" style="max-height:340px; overflow:auto">
                            <table class="table table-sm small mb-0">
                                <thead><tr><th>Fecha</th><th>Prueba</th><th>Resultado</th><th>Valor</th><th>Unidades</th></tr></thead>
                                <tbody>
                                    @foreach (var d in Selected.Details)
                                    {
                                        <tr>
                                            <td class="text-nowrap text-muted">@DVal(d, spec?.DateColumn)</td>
                                            <td>@DVal(d, spec?.TitleColumn)</td>
                                            <td>@DVal(d, spec?.ResultColumn)</td>
                                            <td>@DVal(d, spec?.ValueColumn)</td>
                                            <td class="text-muted">@DVal(d, spec?.UnitsColumn)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">Todos los eventos</div>
            <div class="table-responsive" style="max-height:420px; overflow:auto">
                <table class="table table-hover mb-0 align-middle">
                    <thead style="position:sticky; top:0; background:var(--rx-surface)">
                        <tr><th>Fecha</th><th>Fuente</th><th>Tabla</th><th>Detalle</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Events)
                        {
                            <tr @onclick="() => Selected = ev" style="cursor:pointer">
                                <td class="text-nowrap">@(ev.OccurredAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td>
                                <td><span class="rx-chip">@ev.Fuente</span></td>
                                <td>@ev.TableDisplayName</td>
                                <td class="text-muted small">@Summary(ev)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<style>
    .tl-window { overflow-x: auto; padding: .25rem 0 .5rem; }
    .tl { display: flex; flex-direction: column; gap: .35rem; padding-right: 46px; }
    .tl-axis { position: relative; height: 1.25rem; margin-left: 148px; margin-right: 8px; font-size: .7rem; color: var(--rx-muted); }
    .tl-tick { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; font-variant-numeric: tabular-nums; }
    .tl-lane { display: flex; align-items: center; }
    .tl-label { flex: 0 0 140px; width: 140px; text-align: right; padding-right: 8px; font-size: .8rem; font-weight: 600; color: var(--rx-text-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tl-count { display: inline-block; margin-left: 4px; padding: 0 .35rem; border-radius: 999px; background: var(--rx-surface-2); color: var(--rx-muted); font-size: .65rem; }
    .tl-track { position: relative; flex: 1; height: 46px; margin: 0 8px; border-top: 1px solid var(--rx-border); }
    .tl-track::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 1px dashed var(--rx-border); }
    .tl-dot {
        position: absolute; top: 50%; transform: translate(-50%, -50%);
        width: 13px; height: 13px; border-radius: 50%;
        background: var(--rx-accent); border: 2px solid var(--rx-surface);
        padding: 0; cursor: pointer; transition: transform .1s ease;
    }
    .tl-dot:hover { transform: translate(-50%, -50%) scale(1.35); }
    .tl-dot.is-selected { box-shadow: 0 0 0 4px var(--rx-accent-soft); transform: translate(-50%, -50%) scale(1.25); }
    .tl-dot--cluster { width: auto; min-width: 24px; height: 22px; padding: 0 6px; border-radius: 999px; font-size: 9px; font-weight: 700; color: #fff; display: inline-flex; align-items: center; justify-content: center; }
    .rx-detail { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .5rem 1.25rem; margin: 0; }
    .rx-detail dt { font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: var(--rx-muted); font-weight: 600; }
    .rx-detail dd { margin: 0 0 .35rem; font-size: .85rem; word-break: break-word; }
</style>

@code {
    string Serial = "";
    string SearchedSerial = "";
    bool IsSearching, Searched, IsGenerating;
    string? Msg;

    string ConnStr = "";
    List<TablaConfigDto> Configs = new();
    List<TraceTableSpec> Specs = new();
    List<TraceEventDto> Events = new();
    Dictionary<string, List<TraceEventDto>> Lanes = new(StringComparer.OrdinalIgnoreCase);
    TraceEventDto? Selected;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ds = await DataSources.GetAsync();
            ConnStr = ds.EffectiveOperationalConnectionString ?? "";
            Configs = (await TablasService.GetConfigAsync()).ToList();
            Specs = Configs
                .Where(c => !string.IsNullOrWhiteSpace(c.SerialColumn) && !string.IsNullOrWhiteSpace(c.DateColumn))
                .Select(c => new TraceTableSpec(
                    c.TableName,
                    c.Fuente,
                    string.IsNullOrWhiteSpace(c.DisplayName) ? c.TableName : c.DisplayName!,
                    c.SerialColumn!,
                    c.DateColumn!,
                    c.Columnas.Select(x => x.ColumnName).ToList(),
                    c.Detalle))
                .ToList();
        }
        catch (Exception ex) { Msg = ex.Message; }
    }

    async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Buscar(); }

    async Task Buscar()
    {
        Msg = null; Selected = null; Events = new(); Lanes = new(); Layout = new(StringComparer.OrdinalIgnoreCase); Searched = false;
        if (string.IsNullOrWhiteSpace(Serial)) { Msg = "Escribe un número de serie."; return; }
        if (Specs.Count == 0) { Msg = "No hay tablas con columna serie y fecha configuradas. Ve a Configuración → Tablas y fuentes."; return; }

        IsSearching = true;
        try
        {
            Events = (await TraceService.SearchAsync(ConnStr, Serial.Trim(), Specs)).ToList();
            Lanes = Events.GroupBy(e => string.IsNullOrWhiteSpace(e.Fuente) ? "Sin fuente" : e.Fuente, StringComparer.OrdinalIgnoreCase)
                .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);
            Layout = BuildLayout();
            SearchedSerial = Serial.Trim();
            Searched = true;
        }
        catch (Exception ex) { Msg = "Error: " + ex.Message; }
        finally { IsSearching = false; }
    }

    async Task GenerarReporte()
    {
        if (Events.Count == 0) return;
        var serial = string.IsNullOrWhiteSpace(SearchedSerial) ? Serial.Trim() : SearchedSerial;
        IsGenerating = true;
        try
        {
            var assets = new TraceReportAssets(
                await ReadAssetAsync("img/logo.png"),
                await ReadAssetAsync("img/hussmann.png"));

            var bytes = await ReportService.GeneratePdfAsync(serial, Events, Configs, assets);

            var b64 = Convert.ToBase64String(bytes);
            var safe = new string(serial.Where(char.IsLetterOrDigit).ToArray());
            var name = $"Trazabilidad_{safe}_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
            await JS.InvokeVoidAsync("eval", $"var a=document.createElement('a');a.href='data:application/pdf;base64,{b64}';a.download='{name}';document.body.appendChild(a);a.click();a.remove();");
        }
        catch (Exception ex) { Msg = "No se pudo generar el reporte: " + ex.Message; }
        finally { IsGenerating = false; }
    }

    async Task<byte[]?> ReadAssetAsync(string relative)
    {
        var root = string.IsNullOrWhiteSpace(Env.WebRootPath)
            ? Path.Combine(AppContext.BaseDirectory, "wwwroot")
            : Env.WebRootPath;
        var path = Path.Combine(root, relative.Replace('/', Path.DirectorySeparatorChar));
        return File.Exists(path) ? await File.ReadAllBytesAsync(path) : null;
    }

    DateTime? Min => Events.Where(e => e.OccurredAt.HasValue).Select(e => e.OccurredAt).Min();
    DateTime? Max => Events.Where(e => e.OccurredAt.HasValue).Select(e => e.OccurredAt).Max();

    // Duración total = último registro - primer registro, en horas/minutos/segundos.
    string DurationText
    {
        get
        {
            if (Min is null || Max is null) return "—";
            var total = (long)(Max.Value - Min.Value).TotalSeconds;
            if (total < 0) total = 0;
            var h = total / 3600;
            var m = (total % 3600) / 60;
            var s = total % 60;
            return $"{h}h {m:00}m {s:00}s";
        }
    }

    // Escala automática: más ancho cuantos más eventos, para que los puntos respiren.
    int TimelineMinWidth => Math.Clamp(220 + Events.Count * 22, 900, 2600);

    private sealed record DotPos(TraceEventDto Event, List<TraceEventDto> Events, double Left, int Row, int Count);
    Dictionary<string, List<DotPos>> Layout = new(StringComparer.OrdinalIgnoreCase);

    // Agrupa eventos del mismo instante en un punto con contador y reparte
    // los grupos que caen muy juntos en filas, para que se vean completos.
    Dictionary<string, List<DotPos>> BuildLayout()
    {
        var result = new Dictionary<string, List<DotPos>>(StringComparer.OrdinalIgnoreCase);
        var trackWidth = Math.Max(320, TimelineMinWidth - 156);
        var minPct = 100.0 * 20 / trackWidth;

        foreach (var lane in Lanes)
        {
            var rowEnds = new List<double>();
            var placed = new List<DotPos>();
            var groups = lane.Value
                .GroupBy(e => e.OccurredAt)
                .Select(g => new
                {
                    Left = Pct(g.First()),
                    Events = g.OrderBy(e => e.TableName, StringComparer.OrdinalIgnoreCase)
                               .ThenBy(e => e.Fuente, StringComparer.OrdinalIgnoreCase)
                               .ToList()
                })
                .OrderBy(g => g.Left)
                .ToList();

            foreach (var g in groups)
            {
                var row = 0;
                while (row < rowEnds.Count && g.Left - rowEnds[row] < minPct) row++;
                if (row == rowEnds.Count) rowEnds.Add(g.Left); else rowEnds[row] = g.Left;
                placed.Add(new DotPos(g.Events[0], g.Events, g.Left, row, g.Events.Count));
            }
            result[lane.Key] = placed;
        }
        return result;
    }

    // En un punto agrupado, cada clic recorre los eventos de ese instante.
    void Pick(DotPos dot)
    {
        if (dot.Events.Count <= 1) { Selected = dot.Event; return; }
        var idx = Selected is null ? -1 : dot.Events.IndexOf(Selected);
        Selected = dot.Events[(idx + 1) % dot.Events.Count];
    }

    // Marcas del eje: más cantidad y más finas al acercar.
    List<DateTime> Ticks
    {
        get
        {
            if (Min is null || Max is null) return new();
            var span = Max.Value - Min.Value;
            if (span <= TimeSpan.Zero) return new() { Min.Value };
            var target = Math.Clamp((int)(TimelineMinWidth / 130.0), 4, 30);
            return Enumerable.Range(0, target + 1)
                .Select(i => Min.Value + TimeSpan.FromTicks((long)(span.Ticks * i / (double)target)))
                .ToList();
        }
    }

    double TickPct(DateTime t)
    {
        if (Min is null || Max is null) return 0;
        var total = (Max.Value - Min.Value).TotalSeconds;
        if (total <= 0) return 0;
        return Math.Clamp((t - Min.Value).TotalSeconds / total * 100.0, 0, 100);
    }

    string FormatTick(DateTime t)
    {
        if (Min is null || Max is null) return t.ToString("HH:mm:ss");
        var span = Max.Value - Min.Value;
        return span.TotalDays >= 3 ? t.ToString("MM-dd HH:mm") : t.ToString("HH:mm:ss");
    }


    double Pct(TraceEventDto e)
    {
        if (e.OccurredAt is null || Min is null || Max is null) return 0;
        var total = (Max.Value - Min.Value).TotalSeconds;
        if (total <= 0) return 50;
        return Math.Clamp((e.OccurredAt.Value - Min.Value).TotalSeconds / total * 100.0, 0, 100);
    }

    string Nick(TraceEventDto e, string column)
    {
        var cfg = Configs.FirstOrDefault(c => string.Equals(c.TableName, e.TableName, StringComparison.OrdinalIgnoreCase));
        var col = cfg?.Columnas.FirstOrDefault(c => string.Equals(c.ColumnName, column, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(col?.DisplayName) ? column : col!.DisplayName!;
    }

    IEnumerable<KeyValuePair<string, string?>> Detail(TraceEventDto e)
    {
        var cfg = Configs.FirstOrDefault(c => string.Equals(c.TableName, e.TableName, StringComparison.OrdinalIgnoreCase));
        IEnumerable<string> cols = cfg is not null && cfg.Columnas.Count > 0
            ? cfg.Columnas.Select(c => c.ColumnName)
            : e.Values.Keys;

        var n = 0;
        foreach (var col in cols)
        {
            if (!e.Values.TryGetValue(col, out var val)) continue;
            if (string.IsNullOrWhiteSpace(val)) continue;
            yield return new KeyValuePair<string, string?>(Nick(e, col), val);
            if (++n >= 16) yield break;
        }
    }

    TablaDetalleDto? DetailSpecFor(TraceEventDto e)
    {
        var cfg = Configs.FirstOrDefault(c => string.Equals(c.TableName, e.TableName, StringComparison.OrdinalIgnoreCase));
        if (cfg?.Detalle is not null) return cfg.Detalle;
        if (e.TableName.Contains("VTi_UutRecords", StringComparison.OrdinalIgnoreCase))
            return new TablaDetalleDto("dbo.VTi_UutRecordDetails", "UutRecordID", "ID", "DateTime", "Test", "Result", "Value", "Units");
        return null;
    }

    static string DVal(IReadOnlyDictionary<string, string?> row, string? col) =>
        string.IsNullOrWhiteSpace(col) ? "" : (row.TryGetValue(col!, out var v) ? v ?? "" : "");

    bool IsFailed(TraceEventDto e, IReadOnlyDictionary<string, string?> row)
    {
        var result = DVal(row, DetailSpecFor(e)?.ResultColumn);
        return result.Contains("fail", StringComparison.OrdinalIgnoreCase)
            || result.Contains("fall", StringComparison.OrdinalIgnoreCase);
    }

    int PassedCount(TraceEventDto e) => e.Details?.Count(d => !IsFailed(e, d)) ?? 0;
    int FailedCount(TraceEventDto e) => e.Details?.Count(d => IsFailed(e, d)) ?? 0;

    string Summary(TraceEventDto e)
    {
        var parts = new List<string>();
        foreach (var item in Detail(e).Take(4))
            parts.Add($"{item.Key}: {Trunc(item.Value, 40)}");
        if (e.Details is { Count: > 0 })
            parts.Add($"{e.Details.Count} pruebas ({FailedCount(e)} fallidas)");
        return string.Join(" · ", parts);
    }

    static string Trunc(string? s, int max) =>
        string.IsNullOrEmpty(s) ? "" : (s.Length <= max ? s : s.Substring(0, max) + "…");
}