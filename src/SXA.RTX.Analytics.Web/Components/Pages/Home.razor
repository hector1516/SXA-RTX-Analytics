@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SXA.RTX.Analytics.Application.Abstractions
@using SXA.RTX.Analytics.Domain.Enums
@inject IEquipoService EquipoService
@inject ITablasConfigService TablasService
@inject ISystemTableService SystemService
@inject IConfiguration Config
@inject IJSRuntime JS
@inject IDashboardService Dashboard
@inject IDataSourceService DataSources

<PageTitle>Panel — SXA-RTX Analytics</PageTitle>

<div class="rx-page-head">
    <div>
        <div class="rx-eyebrow">SXA-RTX Analytics</div>
        <h1>Panel de operación</h1>
        <div class="text-muted small">
            @if (LastUpdate.HasValue)
            {
                <span>Última lectura @LastUpdate.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            }
            else
            {
                <span>Sin lecturas registradas</span>
            }
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="rx-chip @(SqlOk == true ? "rx-chip--ok" : SqlOk == false ? "rx-chip--warn" : "rx-chip--off")" title="@SqlMsg">
            <span class="rx-dot"></span> SQL @(SqlOk == true ? "conectado" : SqlOk == false ? "sin conexión" : "…")
        </span>
        <span class="rx-chip @(OdbcOk == true ? "rx-chip--ok" : OdbcOk == false ? "rx-chip--warn" : "rx-chip--off")" title="@OdbcMsg">
            <span class="rx-dot"></span> MAPICS @(OdbcOk == true ? "conectado" : OdbcOk == false ? "sin conexión" : "…")
        </span>
        <a href="/query" class="btn btn-sm btn-primary"><Icon Name="chart" Size="16" /> Nueva consulta</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">VTI en línea</span>
            <span class="rx-kpi__value">@VtiOnline <small>/ @VtiTotal</small></span>
            <span class="rx-chip rx-kpi__foot @(VtiOnline > 0 ? "rx-chip--ok" : "rx-chip--off")"><span class="rx-dot"></span> @(VtiOnline > 0 ? "En línea" : "Sin línea")</span>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">VTech en línea</span>
            <span class="rx-kpi__value">@VtechOnline <small>/ @VtechTotal</small></span>
            <span class="rx-chip rx-kpi__foot @(VtechOnline > 0 ? "rx-chip--ok" : "rx-chip--off")"><span class="rx-dot"></span> @(VtechOnline > 0 ? "En línea" : "Sin línea")</span>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">Equipos configurados</span>
            <span class="rx-kpi__value">@EquiposCount</span>
            <a href="/configuration" class="rx-kpi__foot small text-decoration-none">Administrar equipos →</a>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body rx-kpi">
            <span class="rx-kpi__label">Tablas habilitadas</span>
            <span class="rx-kpi__value">@TablasCount</span>
            <a href="/configuration" class="rx-kpi__foot small text-decoration-none">Tablas VTI/VTech →</a>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Equipos por área</span>
                <span class="text-muted small">@Areas.Count área(s)</span>
            </div>
            <div class="card-body">
                @if (Areas.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        <Icon Name="chart" Size="28" />
                        <div class="mt-2 small">Aún no hay equipos asignados a un área.</div>
                        <a href="/configuration" class="btn btn-sm btn-outline-secondary mt-2">Configurar equipos</a>
                    </div>
                }
                else
                {
                    <div class="rx-chart rx-chart--tall"><canvas id="homeAreas"></canvas></div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Actividad reciente</span>
                <span class="text-muted small">registros por día · últimos 14 días</span>
            </div>
            <div class="card-body">
                @if (Snap is null || Snap.Activity.All(a => a.Count == 0))
                {
                    <div class="text-center text-muted py-5">
                        <Icon Name="activity" Size="28" />
                        <div class="mt-2 small">Sin actividad reciente en las tablas configuradas.</div>
                    </div>
                }
                else
                {
                    <div class="rx-chart rx-chart--md"><canvas id="homeActivity"></canvas></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Última actividad</span>
                <span class="text-muted small">por tabla</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Tabla</th><th class="text-end">7 días</th><th>Último</th></tr></thead>
                    <tbody>
                        @foreach (var t in UltimaActividad)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@t.DisplayName</div>
                                    <div class="text-muted small" style="font-size:.72rem">@t.Fuente</div>
                                </td>
                                <td class="text-end">@t.RecentCount</td>
                                <td class="text-muted">@(t.LastDate?.ToString("MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                        @if (!UltimaActividad.Any()) { <tr><td colspan="3" class="text-center text-muted py-3">Sin datos</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Registros más recientes</span>
                <a href="/trace" class="small text-decoration-none">Ir a trazabilidad →</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead><tr><th>Serie</th><th>Tabla</th><th>Fuente</th><th>Fecha</th></tr></thead>
                    <tbody>
                        @foreach (var r in RegistrosRecientes)
                        {
                            <tr>
                                <td class="font-monospace" style="font-size:.8rem">@r.Serial</td>
                                <td>@r.DisplayName</td>
                                <td>@if (!string.IsNullOrWhiteSpace(r.Fuente)) { <span class="rx-chip">@r.Fuente</span> }</td>
                                <td class="text-muted">@(r.Date?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td>
                            </tr>
                        }
                        @if (!RegistrosRecientes.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">Sin registros recientes</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Últimos equipos</span>
                <a href="/query" class="small text-decoration-none">Ir a consultas →</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead><tr><th>DeviceId</th><th>Nombre</th><th>Área</th><th>Tipo</th><th>Último contacto</th></tr></thead>
                    <tbody>
                        @foreach (var e in UltimosEquipos)
                        {
                            <tr>
                                <td class="font-monospace" style="font-size:.78rem">@e.DeviceId</td>
                                <td>@e.Nombre</td>
                                <td>@if (!string.IsNullOrWhiteSpace(e.Area)) { <span class="rx-chip">@e.Area</span> }</td>
                                <td>@if (e.TipoSync is not null) { <span class="rx-chip">@e.TipoSync</span> }</td>
                                <td class="text-muted">@(e.UltimoContacto?.ToLocalTime().ToString("MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                        @if (!UltimosEquipos.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">Sin equipos</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Resumen</div>
            <div class="card-body d-flex flex-column gap-3">
                <div class="d-flex justify-content-between"><span class="text-muted small">Equipos configurados</span><strong>@EquiposCount</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted small">Tablas habilitadas</span><strong>@TablasCount</strong></div>
                <a href="/query" class="btn btn-primary mt-2"><Icon Name="chart" Size="16" /> Consultar datos</a>
            </div>
        </div>
    </div>
</div>

@code {
    int VtiTotal, VtechTotal, VtiOnline, VtechOnline;
    DateTime? LastUpdate;
    bool? SqlOk, OdbcOk;
    string? SqlMsg, OdbcMsg;
    List<EquipoDto> UltimosEquipos = new();
    List<(string Nombre, int Count)> Areas = new();
    int EquiposCount, TablasCount;
    DashboardSnapshotDto? Snap;
    bool _areasDrawn, _activityDrawn;

    IReadOnlyList<TableActivityDto> UltimaActividad => Snap?.Tables.Take(10).ToList() ?? new List<TableActivityDto>();
    IReadOnlyList<RecentRecordDto> RegistrosRecientes => Snap?.Recent ?? new List<RecentRecordDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cs = Config.GetConnectionString("ConfigurationDatabase");
            var catalog = await EquipoService.GetCatalogAsync(cs);
            VtiTotal = catalog.Count(c => string.Equals(c.TipoMaquina, "VTI", StringComparison.OrdinalIgnoreCase));
            VtechTotal = catalog.Count(c => string.Equals(c.TipoMaquina, "VTech", StringComparison.OrdinalIgnoreCase));
            var threshold = DateTime.UtcNow.AddMinutes(-5);
            VtiOnline = catalog.Count(c => string.Equals(c.TipoMaquina, "VTI", StringComparison.OrdinalIgnoreCase) && c.UltimoContacto.HasValue && c.UltimoContacto.Value > threshold);
            VtechOnline = catalog.Count(c => string.Equals(c.TipoMaquina, "VTech", StringComparison.OrdinalIgnoreCase) && c.UltimoContacto.HasValue && c.UltimoContacto.Value > threshold);
            LastUpdate = catalog.Where(c => c.UltimoContacto.HasValue).MaxBy(c => c.UltimoContacto!.Value)?.UltimoContacto;

            var equipos = await EquipoService.GetEquiposAsync();
            EquiposCount = equipos.Count;
            var map = catalog.ToDictionary(c => c.DeviceId, c => c);
            UltimosEquipos = equipos.Select(e =>
            {
                if (map.TryGetValue(e.DeviceId, out var c))
                {
                    var tipo = c.TipoMaquina?.Equals("VTech", StringComparison.OrdinalIgnoreCase) == true ? EquipoTipo.VTech
                             : c.TipoMaquina?.Equals("VTI", StringComparison.OrdinalIgnoreCase) == true ? EquipoTipo.VTI : (EquipoTipo?)null;
                    return e with { TipoSync = tipo, UltimoContacto = c.UltimoContacto };
                }
                return e;
            }).OrderByDescending(e => e.UltimoContacto ?? DateTime.MinValue).Take(6).ToList();

            Areas = equipos.GroupBy(e => e.Area)
                .Select(g => (Nombre: g.Key, Count: g.Count()))
                .OrderByDescending(x => x.Count).Take(8).ToList();

            var cfg = await TablasService.GetConfigAsync();
            TablasCount = cfg.Count;
        }
        catch { }
        _ = CheckConnections();
    }

    async Task LoadDashboardAsync()
    {
        try
        {
            var ds = await DataSources.GetAsync();
            var cfg = (await TablasService.GetConfigAsync()).ToList();
            Snap = await Dashboard.GetSnapshotAsync(ds.EffectiveOperationalConnectionString, cfg);
            StateHasChanged();
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ = LoadDashboardAsync();

        try
        {
            if (Areas.Count > 0 && !_areasDrawn)
            {
                _areasDrawn = true;
                await JS.InvokeVoidAsync("renderBars", "homeAreas", Areas.Select(a => a.Nombre).ToArray(), Areas.Select(a => a.Count).ToArray(), "Equipos");
            }
            if (Snap is not null && Snap.Activity.Any(a => a.Count > 0) && !_activityDrawn)
            {
                _activityDrawn = true;
                await JS.InvokeVoidAsync("renderChart", "homeActivity", "area", Snap.Activity.Select(a => a.Day).ToArray(), Snap.Activity.Select(a => a.Count).ToArray(), "Registros");
            }
        }
        catch { }
    }

    async Task CheckConnections()
    {
        try
        {
            var cs = Config.GetConnectionString("ConfigurationDatabase");
            if (string.IsNullOrWhiteSpace(cs)) { SqlOk = null; SqlMsg = "InMemory (sin SQL Server)"; OdbcOk = null; OdbcMsg = "DSN=MAPICS (no probado)"; }
            else { var (ok, msg) = await SystemService.TestSqlConnectionAsync(cs); SqlOk = ok; SqlMsg = msg; }
        }
        catch (Exception ex) { SqlOk = false; SqlMsg = ex.Message; }
        try { var (ok, msg) = await SystemService.TestOdbcConnectionAsync("DSN=MAPICS;"); OdbcOk = ok; OdbcMsg = msg; } catch (Exception ex) { OdbcOk = false; OdbcMsg = ex.Message; }
        StateHasChanged();
    }
}
