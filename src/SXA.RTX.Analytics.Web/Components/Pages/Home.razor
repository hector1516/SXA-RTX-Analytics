@page "/"
@rendermode InteractiveServer
@using SXA.RTX.Analytics.Application.Abstractions
@inject IEquipoService EquipoService
@inject ISystemTableService SystemService
@inject IConfiguration Config

<PageTitle>SXA-RTX Analytics — ECCSA</PageTitle>

<section class="rtx-hero p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4 rtx-hero-grid">
        <div class="col-lg-7">
            <div class="rtx-kicker mb-3"><span class="rtx-kicker-dot"></span> SXA-RTX Analytics — ECCSA Automation</div>
            <h1 class="display-5 mb-3">SXA-RTX<br />Analytics</h1>
            <p class="lead mb-4">Plataforma interna de reporting.</p>
            <div class="d-flex flex-wrap gap-2">
                <a href="/health" target="_blank" class="btn btn-primary btn-lg">Ver /health →</a>
                <a href="https://github.com/hector1516/SXA-RTX-Analytics" target="_blank" class="btn btn-outline-light btn-lg rounded-pill" style="border-width:2px">GitHub</a>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <span class="rtx-pill @(VtiOnline>0?"rtx-pill--sky":"")" title="VTI con UltimoContacto &lt; 5min">
                    ● VTI en línea <strong>@VtiOnline</strong> / @VtiTotal
                </span>
                <span class="rtx-pill @(VtechOnline>0?"rtx-pill--honey":"")" title="VTech con UltimoContacto &lt; 5min">
                    ● VTech en línea <strong>@VtechOnline</strong> / @VtechTotal
                </span>
                <span class="rtx-pill" title="Último contacto de cualquier equipo">
                    Última actualización: <strong>@(LastUpdate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</strong>
                </span>
            </div>
        </div>
        <div class="col-lg-5 text-center">
            <img src="img/logo.png" alt="SXA-RTX" class="img-fluid rtx-float" style="max-height: 340px; background: #fff; border-radius: 24px; padding: 12px;" />
            <div class="d-flex justify-content-center gap-2 mt-3">
                <span class="rtx-gauge" title="Presión PROPANO"></span>
                <span class="rtx-gauge" title="Presión OTRO" style="transform: rotate(18deg)"></span>
                <span class="rtx-pill rtx-pill--honey">OK • ACTIVE</span>
            </div>
        </div>
    </div>
</section>

<div class="card">
    <div class="card-body d-flex flex-wrap gap-3 align-items-center justify-content-between">
        <div>
            <div class="fw-bold">Estado del sistema</div>
            <div class="text-muted small">Verifica conexión a SQL Server y MAPICS (ODBC).</div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="rtx-pill @(SqlOk==true?"rtx-pill--mint": SqlOk==false?"bg-danger text-white":"")" title="@SqlMsg">
                SQL @(SqlOk==true ? "✓" : SqlOk==false ? "✕" : "…") @(SqlOk==null ? "verificando..." : SqlOk==true ? "Conectado" : "No conectado")
            </span>
            <span class="rtx-pill @(OdbcOk==true?"rtx-pill--mint": OdbcOk==false?"bg-danger text-white":"")" title="@OdbcMsg">
                MAPICS @(OdbcOk==true ? "✓" : OdbcOk==false ? "✕" : "…") @(OdbcOk==null ? "verificando..." : OdbcOk==true ? "Conectado" : "No conectado")
            </span>
            <a href="/health" target="_blank" class="btn btn-outline-primary btn-sm">/health JSON</a>
            <a href="/health/live" target="_blank" class="btn btn-primary btn-sm">/health/live</a>
        </div>
    </div>
</div>

@code {
    int VtiTotal, VtechTotal, VtiOnline, VtechOnline;
    DateTime? LastUpdate;
    bool? SqlOk, OdbcOk;
    string? SqlMsg, OdbcMsg;

    protected override async Task OnInitializedAsync()
    {
        // Cargar equipos para pills
        try
        {
            // Usa la misma cadena que Configuración (si está vacía, usa demo InMemory)
            var cs = Config.GetConnectionString("ConfigurationDatabase");
            // Si está vacía, EquipoService devolverá demo 2+2
            var catalog = await EquipoService.GetCatalogAsync(cs);
            VtiTotal = catalog.Count(c => string.Equals(c.TipoMaquina, "VTI", StringComparison.OrdinalIgnoreCase));
            VtechTotal = catalog.Count(c => string.Equals(c.TipoMaquina, "VTech", StringComparison.OrdinalIgnoreCase));
            var threshold = DateTime.UtcNow.AddMinutes(-5);
            VtiOnline = catalog.Count(c => string.Equals(c.TipoMaquina, "VTI", StringComparison.OrdinalIgnoreCase) && c.UltimoContacto.HasValue && c.UltimoContacto.Value > threshold);
            VtechOnline = catalog.Count(c => string.Equals(c.TipoMaquina, "VTech", StringComparison.OrdinalIgnoreCase) && c.UltimoContacto.HasValue && c.UltimoContacto.Value > threshold);
            LastUpdate = catalog.Where(c => c.UltimoContacto.HasValue).MaxBy(c => c.UltimoContacto!.Value)?.UltimoContacto;
        }
        catch { }

        // Checks SQL / MAPICS en background
        _ = CheckConnections();
    }

    async Task CheckConnections()
    {
        try
        {
            var cs = Config.GetConnectionString("ConfigurationDatabase");
            if (string.IsNullOrWhiteSpace(cs))
            {
                SqlOk = null; SqlMsg = "InMemory (sin SQL Server)";
                OdbcOk = null; OdbcMsg = "DSN=MAPICS (no probado)";
            }
            else
            {
                var (ok, msg) = await SystemService.TestSqlConnectionAsync(cs);
                SqlOk = ok; SqlMsg = msg;
            }
        }
        catch (Exception ex) { SqlOk = false; SqlMsg = ex.Message; }
        try
        {
            var odbc = "DSN=MAPICS;";
            var (ok, msg) = await SystemService.TestOdbcConnectionAsync(odbc);
            OdbcOk = ok; OdbcMsg = msg;
        }
        catch (Exception ex) { OdbcOk = false; OdbcMsg = ex.Message; }
        StateHasChanged();
    }
}
