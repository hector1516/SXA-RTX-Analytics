<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SXA.RTX.Analytics.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="img/logo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="img/logo.png" />
    <HeadOutlet />
    <script>
        // Tema claro/oscuro: preferencia guardada del usuario > preferencia del sistema.
        // Se ejecuta antes de pintar para evitar el parpadeo al cargar.
        (function () {
            var mq = window.matchMedia('(prefers-color-scheme: dark)');
            function currentTheme() {
                return localStorage.getItem('rx-theme') || (mq.matches ? 'dark' : 'light');
            }
            function apply() {
                document.documentElement.setAttribute('data-bs-theme', currentTheme());
            }
            window.rxSetTheme = function (t) { localStorage.setItem('rx-theme', t); apply(); };
            window.rxToggleTheme = function () {
                window.rxSetTheme(document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark');
            };
            apply();
            try { mq.addEventListener('change', function () { if (!localStorage.getItem('rx-theme')) apply(); }); }
            catch (e) { mq.addListener(function () { if (!localStorage.getItem('rx-theme')) apply(); }); }
        })();
    </script>
</head>

<body>
    @* Modo interactivo a nivel de Routes: cubre tambien MainLayout, que de otro
       modo se renderiza estatico y su OnAfterRenderAsync nunca se ejecuta. *@
    <Routes @rendermode="InteractiveServer" />

    <!-- Toast discreto de reconexión (antes barra inferior) -->
    <div id="components-reconnect-modal" class="components-reconnect-hide">
        <div class="components-reconnect-current">
            <div style="display:flex;align-items:center;gap:.6rem;padding:.6rem .9rem;background:#fff;border:1px solid #D9E2EC;border-radius:999px;box-shadow:0 8px 20px rgba(27,42,78,.14);font-size:.82rem;font-weight:600">
                <span class="spinner-border spinner-border-sm" style="width:1rem;height:1rem" role="status"></span>
                <span>Reconectando...</span>
            </div>
        </div>
        <div class="components-reconnect-failed">
            <div style="display:flex;align-items:center;gap:.6rem;padding:.6rem .9rem;background:#fff;border:1px solid #F5C6CB;border-radius:999px;box-shadow:0 8px 20px rgba(27,42,78,.14);font-size:.82rem">
                <span class="fw-bold">Sin conexión</span>
                <button class="btn btn-xs btn-primary" onclick="window.Blazor.reconnect()">Reintentar</button>
            </div>
        </div>
        <div class="components-reconnect-rejected">
            <div style="display:flex;align-items:center;gap:.6rem;padding:.6rem .9rem;background:#fff;border:1px solid #F5C6CB;border-radius:999px;box-shadow:0 8px 20px rgba(27,42,78,.14);font-size:.82rem">
                <span class="fw-bold">Conexión cerrada</span>
                <button class="btn btn-xs btn-primary" onclick="location.reload()">Recargar</button>
            </div>
        </div>
    </div>
    <style>
        #components-reconnect-modal { position: fixed; top: 1rem; right: 1rem; bottom: auto; left: auto; width: auto; max-width: 90vw; z-index: 9999; background: transparent; border: none; box-shadow: none; padding: 0; }
        #components-reconnect-modal.components-reconnect-hide { display: none; }
        #components-reconnect-modal.components-reconnect-show, #components-reconnect-modal.components-reconnect-failed, #components-reconnect-modal.components-reconnect-rejected { display: block; }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/charts.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
